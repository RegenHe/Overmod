# Local bind address for the standalone Overmod service.
OVERMOD_HOST=127.0.0.1
OVERMOD_PORT=3007
OVERMOD_DATABASE=data/overmod.sqlite3

# SHA-256 of the private administrator token. Generate a new pair with:
#   python server_generate_admin_token.py
OVERMOD_ADMIN_TOKEN_SHA256=

# Overrank read-only integration. The API key must match Overrank.
OVERMOD_OVERRANK_URL=http://127.0.0.1:3005
OVERMOD_OVERRANK_API_KEY=
OVERMOD_POPULAR_CACHE_SECONDS=60

